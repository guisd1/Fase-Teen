# Copie para .env.local (local) ou cadastre em Settings > Environment Variables (Vercel).
# Cada loja é um projeto separado na Vercel, com os próprios valores abaixo.

# Qual loja este projeto publica: fase-teen | ciranda-cirandinha
STORE=fase-teen
# Opcional: domínio público, se for diferente do siteUrl do arquivo da loja
# SITE_URL=https://www.minhaloja.com.br

# Banco de dados (Neon Postgres). A integração Neon da Vercel cria esta variável sozinha.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Painel de administrador (/admin) — um login por loja.
# Gere o hash e o secret com: npm run admin:hash -- "sua senha"
ADMIN_EMAIL=voce@exemplo.com
ADMIN_PASSWORD_HASH=scrypt:...
ADMIN_SESSION_SECRET=...

# Fotos dos produtos (Vercel Blob). A integração Blob da Vercel cria esta variável sozinha.
# BLOB_READ_WRITE_TOKEN=

# Opcional: código da "tag HTML" do Google Search Console (verifica o domínio para o Google Cloud).
# Pode colar só o código ou a tag <meta> inteira. Precisa de Redeploy para valer.
# GOOGLE_SITE_VERIFICATION=

# YouTube (envio de vídeos pelo painel) — credenciais OAuth do Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Melhor Envio
MELHOR_ENVIO_CLIENT_ID=SEU_CLIENT_ID
MELHOR_ENVIO_CLIENT_SECRET=SEU_CLIENT_SECRET
MELHOR_ENVIO_USER_AGENT=Nome da Loja (seuemail@exemplo.com)
STORE_ORIGIN_POSTAL_CODE=00000000
# MELHOR_ENVIO_SERVICES=1,2,17

# Upstash Redis (tokens do Melhor Envio e do YouTube). Pode ser o mesmo nas duas lojas.
# A integração da Vercel cria as variáveis:
# UPSTASH_REDIS_REST_URL
# UPSTASH_REDIS_REST_TOKEN

# Newsletter (Brevo)
BREVO_API_KEY=SUA_API_KEY_DA_BREVO
BREVO_LIST_ID=0
